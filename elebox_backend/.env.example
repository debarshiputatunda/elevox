DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=elevox
DB_USER=root
DB_PASSWORD=





SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOWED_HEADERS=*
ALLOWED_CREDENTIALS=true

# Telemetry poller (per-device orchestrator)
TELEMETRY_POLL_INTERVAL_S=0.15
TELEMETRY_POLL_INTERVAL_HIGH_S=0.15
TELEMETRY_POLL_INTERVAL_ACTIVE_S=0.25
TELEMETRY_POLL_INTERVAL_IDLE_S=1.0
TELEMETRY_POLL_INTERVAL_OFFLINE_S=5.0
TELEMETRY_REGISTRY_SYNC_S=10.0
TELEMETRY_CIRCUIT_BREAKER_FAILURES=5
TELEMETRY_REQUEST_TIMEOUT_S=1.5
TELEMETRY_MAX_CONCURRENT_POLLS=50
TELEMETRY_OFFLINE_THRESHOLD_S=10
TELEMETRY_HISTORY_INTERVAL_S=10.0
TELEMETRY_MAX_RETRIES=2
TELEMETRY_RETRY_DELAY_S=0.25
BATTERY_LOW_THRESHOLD=20
ESP_HOOK_FINE_MIN=2500
ESP_HOOK_FINE_MAX=4500
# Alarm control paths. /trigger fires a one-shot siren pulse (~10s on device).
ESP_ALARM_ON_PATH=/trigger
ESP_ALARM_OFF_PATH=/stop
# Auto dual-hook alarm: cooldown (seconds) between /trigger pulses while both
# hooks stay over threshold. After this elapses, if still violated, pulse again.
DUAL_HOOK_ALARM_COOLDOWN_S=10
ACTIVE_ACTIVITY_STATUS_ID=1
INACTIVE_ACTIVITY_STATUS_ID=2